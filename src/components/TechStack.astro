---
const stackCategories = [
  {
    category: "Procesamiento Batch & Data Enterprise",
    type: "database",
    description: "Dominio especializado en optimización de consultas de alto impacto y procesamiento masivo.",
    technologies: [
      { name: "Oracle SQL & PL/SQL", desc: "Tuning avanzado, índices, partitioning y packages enterprise", badge: "Core Enterprise" },
      { name: "Pro*C / C++", desc: "Integración nativa C para procesos batch de ultra alta velocidad", badge: "Alta Especialidad" },
      { name: "Shell Scripting", desc: "Automatización robusta en Bash, KSH y scripting de servidor", badge: "Mission Critical" },
    ]
  },
  {
    category: "Desarrollo de Software & Microservicios",
    type: "code",
    description: "Arquitecturas escalables para aplicaciones transaccionales y portales corporativos.",
    technologies: [
      { name: "Java Enterprise", desc: "Spring Boot, Jakarta EE y microservicios resilientes", badge: "Backend Standard" },
      { name: "Python Engineering", desc: "FastAPI, procesamiento paralelo y APIs de alta densidad", badge: "Modern Backend" },
      { name: "C / C++ Systems", desc: "Desarrollo a nivel sistema de baja latencia y alta concurrencia", badge: "High Performance" },
    ]
  },
  {
    category: "Infraestructura, Linux & Cloud",
    type: "server",
    description: "Servidores corporativos, contenedores y entornos seguros para alta disponibilidad.",
    technologies: [
      { name: "Linux Enterprise", desc: "Red Hat Enterprise Linux (RHEL), SUSE, Rocky Linux", badge: "OS Standard" },
      { name: "Cloud & DevOps", desc: "Docker, Kubernetes, AWS, Azure, Pipelines CI/CD", badge: "Infrastructure" },
      { name: "Ciberseguridad TI", desc: "Hardening de servidores, cifrado de datos y auditoría ISO 27001", badge: "Security" },
    ]
  }
];
---

<section id="stack-tecnologico" class="py-20 bg-white relative overflow-hidden">
  <!-- Subtle Soft Aura -->
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-pink-100/30 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-corporate-wine bg-corporate-wine-soft px-4 py-1.5 rounded-full border border-corporate-wine-border">
        Ecosistema Tecnológico
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-corporate-midnight font-display">
        Tecnología Robusta y Probada en Entornos Exigentes
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Combinamos tecnologías tradicionales de alto rendimiento con arquitecturas modernas para garantizar estabilidad, escalabilidad y velocidad.
      </p>
    </div>

    <!-- Tech Grid (Google Store Style) -->
    <div class="space-y-12">
      {stackCategories.map((group) => (
        <div class="bg-corporate-light border border-slate-200/80 rounded-3xl p-6 sm:p-8 shadow-google-card">
          <div class="flex items-center gap-3 mb-6 border-b border-slate-200 pb-4">
            <div class="p-3 rounded-2xl bg-corporate-wine text-white shadow-sm">
              {group.type === 'database' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <ellipse cx="12" cy="5" rx="9" ry="3" />
                  <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                </svg>
              )}
              {group.type === 'code' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
              )}
              {group.type === 'server' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
                  <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
                  <line x1="6" x2="6.01" y1="6" y2="6" />
                  <line x1="6" x2="6.01" y1="18" y2="18" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-xl font-bold font-display text-corporate-midnight">{group.category}</h3>
              <p class="text-xs text-slate-500">{group.description}</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {group.technologies.map((tech) => (
              <div class="bg-white border border-slate-200/80 hover:border-corporate-wine p-5 rounded-2xl transition-all duration-300 group hover:-translate-y-1 shadow-xs hover:shadow-google-hover">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-base font-bold text-corporate-midnight font-display group-hover:text-corporate-wine transition-colors">
                    {tech.name}
                  </span>
                  <span class="text-[10px] font-bold text-corporate-wine bg-corporate-wine-soft px-2 py-0.5 rounded-full border border-corporate-wine-border">
                    {tech.badge}
                  </span>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {tech.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
