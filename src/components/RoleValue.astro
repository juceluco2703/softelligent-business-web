---
const roles = [
  {
    id: "ceo",
    role: "Para el CEO / Dirección General",
    title: "Agilidad Estratégica y Aceleración del Time-to-Market",
    badge: "Estrategia & Crecimiento",
    type: "trending",
    color: "bg-corporate-wine",
    benefits: [
      "Aceleración en el lanzamiento de nuevos productos y canales digitales.",
      "Cero riesgo operativo mediante procesos de ingeniería validados.",
      "Alineación total del equipo de software con los objetivos del negocio.",
      "Propiedad absoluta del código fuente y de la propiedad intelectual."
    ],
    metric: "40% Menor Time-to-Market"
  },
  {
    id: "cto",
    role: "Para el CTO / Vicepresidencia de TI",
    title: "Arquitectura Robusta y Reducción de Deuda Técnica",
    badge: "Ingeniería & Operaciones",
    type: "shield",
    color: "bg-corporate-wine-light",
    benefits: [
      "Optimización de procesos batch Oracle SQL y Pro*C con cero fallos.",
      "Células dedicadas senior de integración inmediata sin curva de aprendizaje.",
      "Modernización de sistemas legacy sin interrumpir la operación continua.",
      "Estándares rigurosos de DevSecOps, pruebas automatizadas e integración continua."
    ],
    metric: "99.99% Continuidad en Ventanas Batch"
  },
  {
    id: "cfo",
    role: "Para el CFO / Dirección Financiera",
    title: "Optimización Presupuestal y ROI Medible en 90 Días",
    badge: "Finanzas & Eficiencia",
    type: "dollar",
    color: "bg-corporate-wine-accent",
    benefits: [
      "Estructura de costos transparentes y predecibles sin cargos ocultos.",
      "Maximización del ROI existente en infraestructura Oracle y servidores enterprise.",
      "Reducción de costos de mantenimiento por errores de software en producción.",
      "Modelo flexible de asignación de recursos según la demanda del proyecto."
    ],
    metric: "35% Ahorro Eficiente en OpEx de TI"
  }
];
---

<section id="matriz-valor" class="py-20 bg-corporate-light relative">
  <div class="max-w-screen-2xl mx-auto px-6 lg:px-12">
    
    <!-- Section Header (Left Aligned Google Store Style) -->
    <div class="max-w-3xl mb-12 space-y-3 text-left">
      <span class="text-xs font-bold uppercase tracking-widest text-corporate-wine bg-corporate-wine-soft px-4 py-1.5 rounded-full border border-corporate-wine-border inline-block">
        Matriz de Valor C-Level
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-corporate-midnight font-display">
        Respuesta Exacta a las Prioridades de la Alta Dirección
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Entendemos los indicadores clave (KPIs) que impulsan la toma de decisiones ejecutivas en empresas de alta complejidad tecnológica.
      </p>
    </div>

    <!-- Cards Grid (Full Width 3 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {roles.map((item) => (
        <div class="bg-white rounded-3xl p-8 shadow-google-card hover:shadow-google-hover border border-slate-200/80 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <!-- Badge & Icon Header -->
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-semibold text-corporate-wine uppercase tracking-wider bg-corporate-wine-soft px-3.5 py-1 rounded-full border border-corporate-wine-border">
                {item.badge}
              </span>
              <div class={`w-12 h-12 rounded-2xl ${item.color} flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform`}>
                {item.type === 'trending' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                    <polyline points="16 7 22 7 22 13" />
                  </svg>
                )}
                {item.type === 'shield' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
                {item.type === 'dollar' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <line x1="12" x2="12" y1="2" y2="22" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                  </svg>
                )}
              </div>
            </div>

            <!-- Role & Title -->
            <span class="text-xs font-bold text-corporate-wine uppercase tracking-wider block mb-2">
              {item.role}
            </span>
            <h3 class="text-xl font-bold text-corporate-midnight font-display mb-6 group-hover:text-corporate-wine transition-colors">
              {item.title}
            </h3>

            <!-- Benefits list -->
            <ul class="space-y-3 mb-8">
              {item.benefits.map((benefit) => (
                <li class="flex items-start gap-3 text-sm text-slate-700">
                  <svg class="w-5 h-5 text-corporate-wine shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Metric & CTA -->
          <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-xs text-slate-400 block font-medium">Impacto Garantizado</span>
              <span class="text-sm font-extrabold text-corporate-midnight font-display">{item.metric}</span>
            </div>
            <a
              href="/contacto"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-corporate-wine hover:text-corporate-wine-light transition-colors group-hover:translate-x-1 transition-transform"
            >
              <span>Solicitar Informe</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
