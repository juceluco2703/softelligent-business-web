---
import { TrendingUp, ShieldCheck, DollarSign, ArrowRight, CheckCircle2 } from 'lucide-astro';

const roles = [
  {
    id: "ceo",
    role: "Para el CEO / Dirección General",
    title: "Agilidad Estratégica y Aceleración del Time-to-Market",
    badge: "Estrategia & Crecimiento",
    icon: TrendingUp,
    color: "from-sky-500 to-corporate-cyan",
    benefits: [
      "Aceleración en el lanzamiento de nuevos productos y canales digitales.",
      "Cero riesgo operativo mediante procesos de ingeniería validados.",
      "Alineación total del equipo de software con los objetivos del negocio.",
      "Propiedad absoluta del código fuente y de la propiedad intelectual."
    ],
    metric: "40% Menor Time-to-Market"
  },
  {
    id: "cto",
    role: "Para el CTO / Vicepresidencia de TI",
    title: "Arquitectura Robusta y Reducción de Deuda Técnica",
    badge: "Ingeniería & Operaciones",
    icon: ShieldCheck,
    color: "from-blue-600 to-indigo-600",
    benefits: [
      "Optimización de procesos batch Oracle SQL y Pro*C con cero fallos.",
      "Células dedicadas senior de integración inmediata sin curva de aprendizaje.",
      "Modernización de sistemas legacy sin interrumpir la operación continua.",
      "Estándares rigurosos de DevSecOps, pruebas automatizadas e integración continua."
    ],
    metric: "99.99% Continuidad en Ventanas Batch"
  },
  {
    id: "cfo",
    role: "Para el CFO / Dirección Financiera",
    title: "Optimización Presupuestal y ROI Medible en 90 Días",
    badge: "Finanzas & Eficiencia",
    icon: DollarSign,
    color: "from-emerald-500 to-teal-600",
    benefits: [
      "Estructura de costos transparentes y predecibles sin cargos ocultos.",
      "Maximización del ROI existente en infraestructura Oracle y servidores enterprise.",
      "Reducción de costos de mantenimiento por errores de software en producción.",
      "Modelo flexible de asignación de recursos según la demanda del proyecto."
    ],
    metric: "35% Ahorro Eficiente en OpEx de TI"
  }
];
---

<section id="matriz-valor" class="py-20 bg-corporate-light relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-corporate-cyan bg-sky-100 px-3.5 py-1 rounded-full border border-sky-200">
        Matriz de Valor C-Level
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-corporate-dark font-display">
        Respuesta Exacta a las Prioridades de la Alta Dirección
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Entendemos los indicadores clave (KPIs) que impulsan la toma de decisiones ejecutivas en empresas de alta complejidad tecnológica.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {roles.map((item) => {
        const IconComponent = item.icon;
        return (
          <div class="bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl border border-slate-200 hover:border-corporate-cyan/50 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <!-- Badge & Icon Header -->
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-100 px-3 py-1 rounded-lg">
                  {item.badge}
                </span>
                <div class={`w-12 h-12 rounded-2xl bg-gradient-to-br ${item.color} flex items-center justify-center text-white shadow-md group-hover:scale-110 transition-transform`}>
                  <IconComponent class="w-6 h-6" />
                </div>
              </div>

              <!-- Role & Title -->
              <span class="text-xs font-bold text-corporate-cyan uppercase tracking-wider block mb-1">
                {item.role}
              </span>
              <h3 class="text-xl font-bold text-corporate-dark font-display mb-6 group-hover:text-corporate-blue transition-colors">
                {item.title}
              </h3>

              <!-- Benefits list -->
              <ul class="space-y-3 mb-8">
                {item.benefits.map((benefit) => (
                  <li class="flex items-start gap-3 text-sm text-slate-700">
                    <CheckCircle2 class="w-5 h-5 text-corporate-cyan shrink-0 mt-0.5" />
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Bottom Metric & CTA -->
            <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-xs text-slate-400 block font-medium">Impacto Garantizado</span>
                <span class="text-sm font-extrabold text-corporate-dark font-display">{item.metric}</span>
              </div>
              <a
                href="/contacto"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-corporate-cyan hover:text-corporate-blue transition-colors group-hover:translate-x-1 transition-transform"
              >
                <span>Solicitar Informe</span>
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
