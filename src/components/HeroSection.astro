---
interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
}

const {
  badge = "FÁBRICA DE SOFTWARE B2B & CONSULTORÍA ENTERPRISE",
  title = "Transformamos Complejidad Operativa en Ventaja Competitiva de Alto Rendimiento",
  subtitle = "Diseñamos e implementamos arquitecturas de software a la medida, sistemas batch mission-critical en Oracle SQL/Pro*C e infraestructura de TI para corporativos de alta exigencia.",
} = Astro.props;

const metrics = [
  { value: "99.99%", label: "Uptime Garantizado SLA", detail: "En sistemas críticos de negocio" },
  { value: "-60%", label: "Reducción en Tiempo Batch", detail: "Optimización Oracle SQL & Pro*C" },
  { value: "+150", label: "Proyectos Entregados", detail: "Para sector financiero y corporativo" },
  { value: "100%", label: "Propiedad de Código", detail: "Sin licencias ni ataduras de proveedor" },
];
---

<section class="relative bg-gradient-to-b from-purple-50/50 via-white to-corporate-light text-corporate-text pt-12 pb-20 lg:pt-20 lg:pb-28 overflow-hidden">
  <!-- Glowing background elements -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-[650px] h-[650px] bg-purple-200/35 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      
      <!-- Top Executive Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-100/80 border border-purple-200 text-corporate-purple text-xs font-bold tracking-wider uppercase shadow-xs">
        <svg class="w-4 h-4 text-corporate-purple animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
        <span>{badge}</span>
      </div>

      <!-- Main H1 Title -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight font-display text-corporate-purple-dark leading-[1.15]">
        {title.split("en").length > 1 ? (
          <>
            {title.split("en")[0]} <span class="bg-gradient-to-r from-corporate-purple via-purple-700 to-purple-900 bg-clip-text text-transparent">en {title.split("en").slice(1).join("en")}</span>
          </>
        ) : (
          title
        )}
      </h1>

      <!-- Transactional Subtitle -->
      <p class="text-lg sm:text-xl text-slate-600 font-normal leading-relaxed max-w-3xl mx-auto">
        {subtitle}
      </p>

      <!-- CTA Buttons -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contacto"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl font-bold text-base text-white bg-gradient-to-r from-corporate-purple to-corporate-purple-light hover:from-purple-900 hover:to-purple-800 shadow-purple-glow transition-all duration-300 hover:-translate-y-1"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <span>Agendar Diagnóstico Estratégico</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="#soluciones"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl font-semibold text-base text-corporate-purple bg-white hover:bg-purple-50 border border-purple-200 shadow-xs transition-all duration-300"
        >
          <span>Explorar Soluciones B2B</span>
        </a>
      </div>

      <!-- Trust highlights -->
      <div class="pt-6 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-600 font-medium">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-corporate-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          Células de Desarrollo Ágil Dedicadas
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-corporate-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          Cumplimiento Riguroso de SLAs
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-corporate-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <ellipse cx="12" cy="5" rx="9" ry="3" />
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
          </svg>
          Especialización en Ambientes Oracle & Legacy
        </span>
      </div>

    </div>

    <!-- Executive Metrics Grid -->
    <div class="mt-16 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {metrics.map((m) => (
        <div class="bg-white border border-purple-100 p-6 rounded-2xl text-center shadow-purple-card hover:shadow-purple-glow hover:border-purple-300 transition-all duration-300 group">
          <div class="text-3xl sm:text-4xl font-extrabold font-display text-corporate-purple group-hover:scale-105 transition-transform">
            {m.value}
          </div>
          <div class="text-sm font-bold text-corporate-purple-dark mt-1">
            {m.label}
          </div>
          <div class="text-xs text-slate-500 mt-0.5">
            {m.detail}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
