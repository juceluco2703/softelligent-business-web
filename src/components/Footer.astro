---
const services = [
  { name: 'Consultoría TI', href: '/servicios/consultoria-ti' },
  { name: 'Capacitación TI Empresarial', href: '/servicios/capacitacion-ti' },
  { name: 'Infraestructura de TI', href: '/servicios/infraestructura' },
  { name: 'Fábrica de Software', href: '/servicios/fabrica-de-software' },
  { name: 'Automatización de Procesos', href: '/servicios/automatizacion' },
  { name: 'Páginas y Portales Web', href: '/servicios/desarrollo-web' },
  { name: 'Fábrica de Pruebas QA', href: '/servicios/fabrica-de-pruebas' },
  { name: 'Redes y Telecomunicaciones', href: '/servicios/redes-y-telecomunicaciones' },
];

const quickLinks = [
  { name: 'Diagnóstico C-Level', href: '/contacto' },
  { name: 'Propuesta de Valor por Rol', href: '/#matriz-valor' },
  { name: 'Stack Tecnológico', href: '/#stack-tecnologico' },
  { name: 'Aviso de Privacidad', href: '/contacto' },
];
---

<footer class="bg-corporate-wine text-slate-200 pt-16 pb-8 border-t border-white/10 relative overflow-hidden">
  <!-- Soft Glow -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-screen-2xl mx-auto px-6 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      
      <!-- Col 1: Identity & Value Prop -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center border border-white/20 shadow-sm">
            <!-- Concentric Spiral Logo Icon -->
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="9" stroke-dasharray="40 10" />
              <circle cx="12" cy="12" r="5" stroke-dasharray="25 8" />
              <circle cx="12" cy="12" r="2" fill="currentColor" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-extrabold tracking-tight text-white font-display">
              Softelligent
            </span>
            <span class="text-[10px] tracking-[0.25em] uppercase font-bold text-pink-200 -mt-1">
              BUSINESS
            </span>
          </div>
        </div>
        <p class="text-purple-100/80 text-sm leading-relaxed">
          Socio tecnológico integral para empresas de alto rendimiento. Especialistas en consultoría TI, fábrica de software B2B, infraestructura, QA y automatización de procesos empresariales.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.65 1.65 0 1 0 0 3.3 1.65 1.65 0 0 0 0-3.3Z"/>
            </svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: 8 Services -->
      <div class="lg:col-span-2">
        <h3 class="text-white font-semibold text-base font-display mb-4 flex items-center gap-2">
          <span>Catálogo de Servicios de TI B2B</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 text-sm">
          {services.map((service) => (
            <div>
              <a href={service.href} class="text-purple-100/80 hover:text-white transition-colors inline-flex items-center gap-1 group">
                <span>{service.name}</span>
                <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-pink-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Col 3: Executive Contact -->
      <div class="space-y-3">
        <h3 class="text-white font-semibold text-base font-display mb-4">Contacto Directivo</h3>
        <div class="flex items-start gap-3 text-sm text-purple-100/80">
          <svg class="w-5 h-5 text-pink-200 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>Ciudad de México, México (Atención a Nivel Nacional e Internacional)</span>
        </div>
        <div class="flex items-center gap-3 text-sm text-purple-100/80">
          <svg class="w-5 h-5 text-pink-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <a href="tel:+525512345678" class="hover:text-white transition-colors">+52 (55) 1234-5678</a>
        </div>
        <div class="flex items-center gap-3 text-sm text-purple-100/80">
          <svg class="w-5 h-5 text-pink-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          <a href="mailto:contacto@softelligent-business.com.mx" class="hover:text-white transition-colors">contacto@softelligent-business.com.mx</a>
        </div>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-medium bg-white/10 text-white border border-white/20">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Disponibilidad SLA 24/7 para Clientes Enterprise
          </span>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between text-xs text-purple-200/70 gap-4">
      <p>© {new Date().getFullYear()} Softelligent Business (softelligent-business.com.mx). Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4 text-pink-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          Seguridad & Cumplimiento ISO/IEC 27001
        </span>
      </div>
    </div>
  </div>
</footer>
