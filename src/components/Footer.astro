---
import { Cpu, Mail, Phone, MapPin, ShieldCheck, Linkedin, Twitter, ArrowUpRight } from 'lucide-astro';

const services = [
  { name: 'Fábrica de Software a la Medida', href: '/fabrica-de-software' },
  { name: 'Desarrollo Batch Oracle SQL & Pro*C', href: '/desarrollo-batch-oracle' },
  { name: 'Consultoría de Arquitectura TI', href: '/consultoria-ti' },
  { name: 'Redes y Telecomunicaciones', href: '/redes-y-telecomunicaciones' },
];

const quickLinks = [
  { name: 'Diagnóstico C-Level', href: '/contacto' },
  { name: 'Propuesta de Valor por Rol', href: '/#matriz-valor' },
  { name: 'Stack Tecnológico', href: '/#stack-tecnologico' },
  { name: 'Aviso de Privacidad', href: '/contacto' },
];
---

<footer class="bg-corporate-dark text-slate-300 pt-16 pb-8 border-t border-slate-800 relative overflow-hidden">
  <!-- Subtle Background Glow -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-corporate-navy/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      
      <!-- Col 1: Identity & Value Prop -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-corporate-cyan to-corporate-blue flex items-center justify-center shadow-glow">
            <Cpu class="w-6 h-6 text-white" />
          </div>
          <span class="text-xl font-bold tracking-tight text-white font-display">
            SOFTELLIGENT
          </span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          Socio tecnológico de alto rendimiento para corporativos e instituciones financieras. Especialistas en desarrollo batch mission-critical, arquitectura cloud y fábrica de software a la medida.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-corporate-cyan transition-colors" aria-label="LinkedIn">
            <Linkedin class="w-5 h-5" />
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-corporate-cyan transition-colors" aria-label="Twitter">
            <Twitter class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h3 class="text-white font-semibold text-base font-display mb-4 flex items-center gap-2">
          <span>Soluciones B2B Enterprise</span>
        </h3>
        <ul class="space-y-2.5 text-sm">
          {services.map((service) => (
            <li>
              <a href={service.href} class="hover:text-corporate-cyan transition-colors inline-flex items-center gap-1 group">
                <span>{service.name}</span>
                <ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-corporate-cyan" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-base font-display mb-4">Acceso Rápido</h3>
        <ul class="space-y-2.5 text-sm">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-corporate-cyan transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Executive Contact -->
      <div class="space-y-3">
        <h3 class="text-white font-semibold text-base font-display mb-4">Contacto Directivo</h3>
        <div class="flex items-start gap-3 text-sm text-slate-400">
          <MapPin class="w-5 h-5 text-corporate-cyan shrink-0 mt-0.5" />
          <span>Ciudad de México, México (Atención a Nivel Nacional e Internacional)</span>
        </div>
        <div class="flex items-center gap-3 text-sm text-slate-400">
          <Phone class="w-5 h-5 text-corporate-cyan shrink-0" />
          <a href="tel:+525512345678" class="hover:text-white transition-colors">+52 (55) 1234-5678</a>
        </div>
        <div class="flex items-center gap-3 text-sm text-slate-400">
          <Mail class="w-5 h-5 text-corporate-cyan shrink-0" />
          <a href="mailto:contacto@softelligent-business.com.mx" class="hover:text-white transition-colors">contacto@softelligent-business.com.mx</a>
        </div>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Disponibilidad SLA 24/7 para Clientes Enterprise
          </span>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {new Date().getFullYear()} Softelligent Business (softelligent-business.com.mx). Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1">
          <ShieldCheck class="w-4 h-4 text-corporate-cyan" />
          Seguridad & Cumplimiento ISO/IEC 27001
        </span>
      </div>
    </div>
  </div>
</footer>
