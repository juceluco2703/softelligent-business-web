---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import RoleValue from '../components/RoleValue.astro';
import TechStack from '../components/TechStack.astro';
import ContactForm from '../components/ContactForm.astro';
import { Layers, Database, Cpu, Network, ArrowRight, ShieldCheck, Award, Zap, Building2, CheckCircle2 } from 'lucide-astro';

const servicesSummary = [
  {
    icon: Layers,
    title: "Fábrica de Software a la Medida",
    description: "Células ágiles dedicadas de ingenieros senior para construir soluciones empresariales escalables con 100% de propiedad de código.",
    href: "/fabrica-de-software",
    highlights: ["Metodología Agile/Scrum", "Arquitecturas en Microservicios", "Cero Deuda Técnica"]
  },
  {
    icon: Database,
    title: "Desarrollo Batch Oracle SQL & Pro*C",
    description: "Especialización en procesamiento masivo de datos, reducción de ventanas batch nocturnas y tuning de base de datos mission-critical.",
    href: "/desarrollo-batch-oracle",
    highlights: ["Pro*C / C++ Native Integration", "Pl/SQL Advanced Tuning", "Shell Scripts de Alta Velocidad"]
  },
  {
    icon: Cpu,
    title: "Consultoría de TI & Arquitectura",
    description: "Evaluación independiente de sistemas, estrategia de migración cloud, refactorización legacy y auditoría de ciberseguridad.",
    href: "/consultoria-ti",
    highlights: ["Modernización Legacy", "Cloud Native Strategy", "Auditoría de Rendimiento"]
  },
  {
    icon: Network,
    title: "Redes & Telecomunicaciones",
    description: "Diseño e implementación de infraestructura física y lógica corporativa, SD-WAN, enlaces de alta velocidad y SOC/NOC.",
    href: "/redes-y-telecomunicaciones",
    highlights: ["Infraestructura Corporativa", "Hardening & Ciberseguridad", "SOP & Monitoreo 24/7"]
  }
];

const stats = [
  { label: "Años de Experiencia Enterprise", value: "+12" },
  { label: "Registros Procesados por Hora en Batch", value: "+500M" },
  { label: "Disponibilidad Garantizada por SLA", value: "99.99%" },
  { label: "Satisfacción Directiva C-Level", value: "100%" }
];
---

<Layout
  title="Softelligent Business | Fábrica de Software & Desarrollo Batch Oracle SQL Pro*C"
  description="Fábrica de software a la medida, desarrollo batch mission-critical en Oracle SQL, Pro*C, consultoría de arquitectura de TI y redes corporativas en México."
>
  
  <!-- Hero Section -->
  <HeroSection />

  <!-- Solutions Summary Section -->
  <section id="soluciones" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-corporate-cyan bg-sky-50 px-3.5 py-1 rounded-full border border-sky-200">
          Soluciones B2B Especializadas
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-corporate-dark font-display">
          Ingeniería de Software e Infraestructura Enterprise
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          Servicios diseñados para elevar la velocidad operativa, reducir riesgos y garantizar la continuidad tecnológica de su negocio.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {servicesSummary.map((s) => {
          const ServiceIcon = s.icon;
          return (
            <div class="bg-corporate-light border border-slate-200 hover:border-corporate-cyan/60 rounded-3xl p-8 transition-all duration-300 hover:shadow-xl group flex flex-col justify-between">
              <div>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-corporate-dark to-corporate-navy text-corporate-cyan flex items-center justify-center mb-6 shadow-md group-hover:scale-110 transition-transform">
                  <ServiceIcon class="w-7 h-7" />
                </div>
                <h3 class="text-2xl font-bold text-corporate-dark font-display mb-3 group-hover:text-corporate-blue transition-colors">
                  {s.title}
                </h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                  {s.description}
                </p>
                <ul class="space-y-2 mb-8">
                  {s.highlights.map((h) => (
                    <li class="flex items-center gap-2 text-xs font-semibold text-slate-700">
                      <CheckCircle2 class="w-4 h-4 text-corporate-cyan" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-4 border-t border-slate-200/80 flex items-center justify-between">
                <a
                  href={s.href}
                  class="inline-flex items-center gap-2 text-sm font-bold text-corporate-cyan hover:text-corporate-blue transition-colors"
                >
                  <span>Ver Detalle de la Solución</span>
                  <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- Role Value Matrix Section -->
  <RoleValue />

  <!-- Enterprise Impact Numbers Section -->
  <section class="py-16 bg-gradient-to-r from-corporate-dark via-corporate-navy to-corporate-dark text-white border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {stats.map((st) => (
          <div class="space-y-2">
            <div class="text-4xl sm:text-5xl font-extrabold font-display text-corporate-cyan">
              {st.value}
            </div>
            <div class="text-xs sm:text-sm text-slate-300 font-medium max-w-[200px] mx-auto">
              {st.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack Section -->
  <TechStack />

  <!-- Executive Conversion Contact Section -->
  <section class="py-20 bg-corporate-slate relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm
        title="Agende su Diagnóstico Estratégico con la Dirección de TI"
        subtitle="Analicemos juntos los cuellos de botella técnicos, oportunidades de optimización y requerimientos de desarrollo de su organización."
      />
    </div>
  </section>

</Layout>
