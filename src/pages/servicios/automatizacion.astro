---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';

const autoServices = [
  {
    title: "Automatización de Procesos de Negocio (RPA & BPA)",
    desc: "Robots de software para automatizar tareas repetitivas de captura, conciliación de facturas y flujos de trabajo interdepartamentales.",
    type: "cpu"
  },
  {
    title: "Automatización de Procesos Batch & Datos Masivos",
    desc: "Orquestación de tareas nocturnas, scripts Shell/Python y procedimientos almacenados Oracle SQL para procesamiento de gran volumen.",
    type: "database"
  },
  {
    title: "Integración de Sistemas & APIs Transaccionales",
    desc: "Conexión automatizada entre ERPs (SAP, Oracle), CRMs y plataformas bancarias eliminando la intervención manual.",
    type: "layers"
  },
  {
    title: "Monitoreo Automatizado & Alertas en Tiempo Real",
    desc: "Flujos de notificación automática ante fallos de servidor, cuellos de botella o desviaciones de indicadores de negocio.",
    type: "bell"
  }
];
---

<Layout
  title="Automatización de Procesos Empresariales y RPA B2B | Softelligent Business"
  description="Automatización de procesos empresariales en México, soluciones RPA, integración de APIs, orquestación de batch y optimización del flujo de trabajo."
>
  
  <!-- Hero -->
  <section class="bg-corporate-wine text-white pt-16 pb-20 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl space-y-6 text-left">
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-purple-100 text-xs font-bold uppercase tracking-wider">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
          </svg>
          <span>Eficiencia Operativa Enterprise</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold font-display leading-tight">
          Automatización de Procesos Empresariales y RPA B2B
        </h1>

        <p class="text-lg text-purple-100 leading-relaxed">
          Eliminamos la carga operativa manual y los errores humanos mediante bots inteligentes, orquestación de datos masivos e integración de sistemas.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="#diagnostico-form"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-bold text-corporate-wine bg-white hover:bg-purple-50 shadow-md transition-all"
          >
            <span>Evaluar Mis Procesos a Automatizar</span>
            <svg class="w-4 h-4 text-corporate-wine" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-12">
      
      <div class="max-w-3xl mb-12 space-y-3 text-left">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-corporate-midnight font-display">
          Soluciones de Automatización Inteligente
        </h2>
        <p class="text-slate-600 text-base">
          Transformamos procesos complejos y tardíos en ejecuciones automáticas inmediatas y con trazabilidad completa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {autoServices.map((s) => (
          <div class="bg-corporate-light p-8 rounded-3xl border border-slate-200/90 hover:border-corporate-wine transition-all flex items-start gap-5 shadow-google-card hover:shadow-google-hover">
            <div class="w-12 h-12 rounded-2xl bg-corporate-wine text-white flex items-center justify-center shrink-0 shadow-sm">
              {s.type === 'cpu' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <rect width="16" height="16" x="4" y="4" rx="2" />
                  <rect width="6" height="6" x="9" y="9" rx="1" />
                  <path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" />
                </svg>
              )}
              {s.type === 'database' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <ellipse cx="12" cy="5" rx="9" ry="3" />
                  <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                </svg>
              )}
              {s.type === 'layers' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
              )}
              {s.type === 'bell' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                  <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-xl font-bold text-corporate-midnight font-display mb-2">{s.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Form -->
  <section id="diagnostico-form" class="py-20 bg-corporate-light">
    <div class="max-w-4xl mx-auto px-6 lg:px-12">
      <ContactForm
        title="Solicite un Análisis de Automatización de Procesos"
        subtitle="Identificaremos los flujos operativos con mayor potencial de ahorro de tiempo y costos para su empresa."
        defaultService="Automatizacion Procesos"
      />
    </div>
  </section>

</Layout>
