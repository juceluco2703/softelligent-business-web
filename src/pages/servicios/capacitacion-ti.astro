---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';

const modules = [
  {
    title: "Capacitación Avanzada Oracle SQL & PL/SQL Tuning",
    desc: "Formación especializada para equipos de base de datos en optimización de consultas, particionamiento e índices de alto volumen.",
    badge: "Bases de Datos"
  },
  {
    title: "Arquitectura Cloud & Microservicios para Equipos Senior",
    desc: "Workshops prácticos de diseño de API RESTful, contenedores Docker, Kubernetes y patrones de resiliencia empresarial.",
    badge: "Cloud & Backend"
  },
  {
    title: "Desarrollo Batch Pro*C y C/C++ Empresarial",
    desc: "Instrucción de bajo nivel para mantenimiento y aceleración de sistemas batch transaccionales mission-critical.",
    badge: "Low-Level & Legacy"
  },
  {
    title: "Buenas Prácticas DevSecOps & CI/CD",
    desc: "Cursos intensivos en automatización de despliegues, seguridad defensiva OWASP y pipelines de integración continua.",
    badge: "DevOps & Ciberseguridad"
  }
];
---

<Layout
  title="Capacitación TI Empresarial y Formación Técnica B2B | Softelligent Business"
  description="Capacitación TI empresarial a la medida para equipos de desarrollo e infraestructura. Cursos de Oracle SQL, Pro*C, Cloud Architecture y DevSecOps en México."
>
  
  <!-- Hero -->
  <section class="bg-corporate-wine text-white pt-16 pb-20 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl space-y-6 text-left">
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-purple-100 text-xs font-bold uppercase tracking-wider">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
          <span>Formación Técnica Empresarial</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold font-display leading-tight">
          Capacitación TI Empresarial a la Medida para Equipos de Ingeniería
        </h1>

        <p class="text-lg text-purple-100 leading-relaxed">
          Elevamos las competencias de su personal técnico con programas prácticos impartidos por arquitectos senior en tecnologías de alta demanda.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="#diagnostico-form"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-bold text-corporate-wine bg-white hover:bg-purple-50 shadow-md transition-all"
          >
            <span>Solicitar Temario a la Medida</span>
            <svg class="w-4 h-4 text-corporate-wine" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Grid Modules -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-12">
      
      <div class="max-w-3xl mb-12 space-y-3 text-left">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-corporate-midnight font-display">
          Programas de Capacitación Técnica Especializada
        </h2>
        <p class="text-slate-600 text-base">
          Cursos diseñados para resolver problemáticas reales de producción y acelerar la curva de aprendizaje en su empresa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {modules.map((m) => (
          <div class="bg-corporate-light p-8 rounded-3xl border border-slate-200/90 hover:border-corporate-wine transition-all flex flex-col justify-between shadow-google-card hover:shadow-google-hover">
            <div>
              <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-corporate-wine bg-corporate-wine-soft px-3 py-1 rounded-full border border-corporate-wine-border mb-4">
                {m.badge}
              </span>
              <h3 class="text-xl font-bold text-corporate-midnight font-display mb-3">{m.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-6">{m.desc}</p>
            </div>
            <a href="#diagnostico-form" class="text-xs font-bold text-corporate-wine hover:text-corporate-wine-light inline-flex items-center gap-1">
              <span>Cotizar Programa para Mi Equipo</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Form -->
  <section id="diagnostico-form" class="py-20 bg-corporate-light">
    <div class="max-w-4xl mx-auto px-6 lg:px-12">
      <ContactForm
        title="Solicite un Plan de Capacitación TI Empresarial"
        subtitle="Analizaremos las brechas de conocimiento de su equipo y diseñaremos un programa 100% adaptado a sus tecnologías."
        defaultService="Capacitacion TI"
      />
    </div>
  </section>

</Layout>
