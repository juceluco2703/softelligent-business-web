---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';

const webServices = [
  {
    title: "Portales Corporativos & Sitios B2B de Alto Rendimiento",
    desc: "Desarrollo con Astro, Next.js y Tailwind CSS optimizados para lograr 100/100 en Google PageSpeed y máxima conversión C-Level.",
    type: "globe"
  },
  {
    title: "Sistemas Web Transaccionales & Portales de Clientes",
    desc: "Plataformas web seguras para gestión de clientes, facturación, consultas financieras y paneles administrativos interactivos.",
    type: "layout"
  },
  {
    title: "Arquitectura Headless & CMS Empresarial",
    desc: "Desacoplamiento del frontend y backend mediante APIs REST/GraphQL con gestión de contenido ágil y segura.",
    type: "code"
  },
  {
    title: "Optimización SEO Técnico & WPO B2B",
    desc: "Indexabilidad avanzada, datos estructurados Schema.org, accesibilidad WCAG y tiempos de carga relámpago.",
    type: "search"
  }
];
---

<Layout
  title="Desarrollo de Páginas y Portales Web B2B | Softelligent Business"
  description="Desarrollo de portales web corporativos y páginas web B2B de alto rendimiento en México. SEO técnico, velocidad 100/100 PageSpeed e integración de sistemas."
>
  
  <!-- Hero -->
  <section class="bg-corporate-wine text-white pt-16 pb-20 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl space-y-6 text-left">
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-purple-100 text-xs font-bold uppercase tracking-wider">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="2" x2="22" y1="12" y2="12" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span>Portales Web Enterprise</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold font-display leading-tight">
          Desarrollo de Páginas y Portales Web B2B de Alto Rendimiento
        </h1>

        <p class="text-lg text-purple-100 leading-relaxed">
          Diseñamos y desarrollamos plataformas web corporativas rápidas, seguras y estructuradas estratégicamente para la captación de leads de nivel C-Level.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="#diagnostico-form"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-bold text-corporate-wine bg-white hover:bg-purple-50 shadow-md transition-all"
          >
            <span>Cotizar Portal Corporativo</span>
            <svg class="w-4 h-4 text-corporate-wine" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Grid Features -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-12">
      
      <div class="max-w-3xl mb-12 space-y-3 text-left">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-corporate-midnight font-display">
          Ingeniería Web de Clase Mundial
        </h2>
        <p class="text-slate-600 text-base">
          Portales diseñados bajo estándares modernos de desarrollo, accesibilidad y velocidad de carga ultrarrápida.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {webServices.map((s) => (
          <div class="bg-corporate-light p-8 rounded-3xl border border-slate-200/90 hover:border-corporate-wine transition-all flex items-start gap-5 shadow-google-card hover:shadow-google-hover">
            <div class="w-12 h-12 rounded-2xl bg-corporate-wine text-white flex items-center justify-center shrink-0 shadow-sm">
              {s.type === 'globe' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" x2="22" y1="12" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              )}
              {s.type === 'layout' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                  <line x1="3" x2="21" y1="9" y2="9" />
                  <line x1="9" x2="9" y1="21" y2="9" />
                </svg>
              )}
              {s.type === 'code' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
              )}
              {s.type === 'search' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" x2="16.65" y1="21" y2="16.65" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-xl font-bold text-corporate-midnight font-display mb-2">{s.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Form -->
  <section id="diagnostico-form" class="py-20 bg-corporate-light">
    <div class="max-w-4xl mx-auto px-6 lg:px-12">
      <ContactForm
        title="Solicite una Cotización de Desarrollo Web Corporativo"
        subtitle="Analizaremos sus objetivos comerciales y diseñaremos una propuesta técnica de alto impacto."
        defaultService="Desarrollo Web"
      />
    </div>
  </section>

</Layout>
