---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

const servicesList = [
  {
    title: "Auditoría de Arquitectura & Código Fuente",
    desc: "Revisión profunda de mantenibilidad, seguridad, rendimiento y adherencia a estándares OWASP / ISO 27001.",
    type: "file-check"
  },
  {
    title: "Modernización de Sistemas Legacy",
    desc: "Estrategias de desacoplamiento progresivo (Patrón Strangler Fig) para evolucionar monolitos hacia microservicios.",
    type: "layers"
  },
  {
    title: "Estrategia & Migración Cloud Native",
    desc: "Diseño de arquitecturas híbridas y multi-cloud con Kubernetes, Docker y automatización con TerraForm y CI/CD.",
    type: "cloud"
  },
  {
    title: "Gobernanza TI & Ciberseguridad",
    desc: "Implementación de mejores prácticas DevSecOps, políticas de respaldo, plan de recuperación ante desastres (DRP).",
    type: "shield"
  }
];
---

<Layout
  title="Consultoría de TI & Arquitectura de Software Enterprise | Softelligent Business"
  description="Servicios de consultoría de TI, auditoría de arquitectura de software, transformación digital y modernización de sistemas legacy para corporativos."
>
  
  <!-- Subpage Hero -->
  <section class="bg-corporate-dark text-white pt-16 pb-20 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute top-10 right-10 w-96 h-96 bg-corporate-cyan/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-800 border border-corporate-cyan/40 text-corporate-cyan text-xs font-semibold uppercase tracking-wider">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect width="16" height="16" x="4" y="4" rx="2" />
            <rect width="6" height="6" x="9" y="9" rx="1" />
            <path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" />
          </svg>
          <span>Consultoría de TI Senior</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold font-display leading-tight">
          Consultoría de Arquitectura de Software y Transformación Digital
        </h1>

        <p class="text-lg text-slate-300 leading-relaxed">
          Diseñamos hojas de ruta tecnológicas objetivas para modernizar sus aplicaciones, erradicar cuellos de botella y reducir costos de infraestructura.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="#diagnostico-consultoria"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-corporate-cyan to-corporate-blue hover:from-sky-500 hover:to-blue-600 shadow-glow transition-all"
          >
            <span>Agendar Sesión de Arquitectura</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <h2 class="text-3xl font-extrabold text-corporate-dark font-display">
          Servicios de Consultoría Especializada
        </h2>
        <p class="text-slate-600 text-base">
          Acompañamos a los equipos directivos de TI en las decisiones de diseño estructural más complejas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {servicesList.map((s) => (
          <div class="bg-corporate-light p-8 rounded-3xl border border-slate-200 hover:border-corporate-cyan transition-all flex items-start gap-5">
            <div class="w-12 h-12 rounded-2xl bg-corporate-dark text-corporate-cyan flex items-center justify-center shrink-0 shadow-md">
              {s.type === 'file-check' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                  <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                  <path d="m9 15 2 2 4-4" />
                </svg>
              )}
              {s.type === 'layers' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
              )}
              {s.type === 'cloud' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                </svg>
              )}
              {s.type === 'shield' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-xl font-bold text-corporate-dark font-display mb-2">{s.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Form Section -->
  <section id="diagnostico-consultoria" class="py-20 bg-corporate-slate">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm
        title="Solicite un Diagnóstico de Arquitectura TI"
        subtitle="Coordine una sesión técnica confidencial con nuestros consultores de arquitectura senior."
        defaultService="Consultoria TI"
      />
    </div>
  </section>

</Layout>
