---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

const telecomServices = [
  {
    title: "Infraestructura & Cableado Estructurado Enterprise",
    desc: "Diseño e instalación de redes físicas categoría 6A/7 y enlaces de fibra óptica para data centers y corporativos.",
    type: "server"
  },
  {
    title: "Redes SD-WAN & Interconexión Sucursales",
    desc: "Implementación de redes definidas por software con túneles VPN redundantes y optimización dinámica de tráfico.",
    type: "wifi"
  },
  {
    title: "Ciberseguridad Perimetral & Next-Gen Firewalls",
    desc: "Hardening de routers/firewalls (Fortinet, Cisco, Palo Alto), detección de intrusos (IDS/IPS) y filtrado avanzado.",
    type: "lock"
  },
  {
    title: "Servicios Administrados NOC / SOC 24/7",
    desc: "Monitoreo continuo de estado de enlaces, ancho de banda, alertas preventivas y respuesta inmediata ante incidentes.",
    type: "shield"
  }
];
---

<Layout
  title="Redes y Telecomunicaciones Corporativas | Softelligent Business"
  description="Soluciones de redes corporativas, SD-WAN, infraestructura de telecomunicaciones, ciberseguridad y servicios administrados NOC/SOC 24/7 en México."
>
  
  <!-- Subpage Hero -->
  <section class="bg-corporate-dark text-white pt-16 pb-20 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute top-10 left-10 w-96 h-96 bg-corporate-cyan/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-800 border border-corporate-cyan/40 text-corporate-cyan text-xs font-semibold uppercase tracking-wider">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect width="6" height="6" x="16" y="16" rx="1" />
            <rect width="6" height="6" x="2" y="16" rx="1" />
            <rect width="6" height="6" x="9" y="2" rx="1" />
            <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3" />
            <path d="M12 12V8" />
          </svg>
          <span>Infraestructura & Ciberseguridad</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold font-display leading-tight">
          Redes, Telecomunicaciones e Infraestructura Corporativa
        </h1>

        <p class="text-lg text-slate-300 leading-relaxed">
          Garantizamos la conectividad ininterrumpida, velocidad de transporte de datos y protección perimetral para sus oficinas, plantas y data centers.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="#diagnostico-redes"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-corporate-cyan to-corporate-blue hover:from-sky-500 hover:to-blue-600 shadow-glow transition-all"
          >
            <span>Cotizar Infraestructura de Red</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Telecom Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <h2 class="text-3xl font-extrabold text-corporate-dark font-display">
          Soluciones Integrales de Conectividad
        </h2>
        <p class="text-slate-600 text-base">
          Infraestructura lógica y física diseñada bajo las normativas internacionales TIA/EIA e ISO.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {telecomServices.map((s) => (
          <div class="bg-corporate-light p-8 rounded-3xl border border-slate-200 hover:border-corporate-cyan transition-all flex items-start gap-5">
            <div class="w-12 h-12 rounded-2xl bg-corporate-dark text-corporate-cyan flex items-center justify-center shrink-0 shadow-md">
              {s.type === 'server' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
                  <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
                  <line x1="6" x2="6.01" y1="6" y2="6" />
                  <line x1="6" x2="6.01" y1="18" y2="18" />
                </svg>
              )}
              {s.type === 'wifi' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M12 20h.01" />
                  <path d="M2 8.82a15 15 0 0 1 20 0" />
                  <path d="M5 12.85a10 10 0 0 1 14 0" />
                  <path d="M8.5 16.88a5 5 0 0 1 7 0" />
                </svg>
              )}
              {s.type === 'lock' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
              )}
              {s.type === 'shield' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-xl font-bold text-corporate-dark font-display mb-2">{s.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Form Section -->
  <section id="diagnostico-redes" class="py-20 bg-corporate-slate">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm
        title="Agende una Evaluación de Infraestructura de Red"
        subtitle="Analizaremos el estado actual de su red perimetral, enlaces y esquemas de ciberseguridad."
        defaultService="Redes Telecom"
      />
    </div>
  </section>

</Layout>
