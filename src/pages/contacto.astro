---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

const steps = [
  {
    step: "01",
    title: "Contacto & Firma de NDA",
    desc: "Recibimos su requerimiento y firmamos acuerdo de confidencialidad previo a cualquier intercambio de información sensible."
  },
  {
    step: "02",
    title: "Sesión Técnica de 30 Minutos",
    desc: "Reunión privada con nuestros Arquitectos Senior para revisar arquitectura actual, objetivos y restricciones del proyecto."
  },
  {
    step: "03",
    title: "Entrega de Dictamen & Propuesta",
    desc: "Presentamos un plan de trabajo detallado con alcance, tiempos, matriz de riesgos y estimación de inversión económica."
  }
];
---

<Layout
  title="Agendar Diagnóstico C-Level | Softelligent Business"
  description="Agende una sesión de diagnóstico estratégico con la dirección de arquitectura TI de Softelligent Business. Soluciones B2B a la medida con garantía NDA."
>
  
  <!-- Header Hero -->
  <section class="bg-gradient-to-b from-purple-950 via-purple-900 to-purple-950 text-white pt-16 pb-20 border-b border-purple-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-purple-200 bg-purple-900/80 px-3.5 py-1 rounded-full border border-purple-700">
          Atención Directa C-Level
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold font-display">
          Agende un Diagnóstico Estratégico de TI
        </h1>
        <p class="text-base sm:text-lg text-purple-100">
          Coordine una sesión privada con nuestros Directores de Arquitectura para abordar sus desafíos de desarrollo, procesos batch o infraestructura.
        </p>
      </div>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="py-12 bg-white border-b border-purple-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {steps.map((st) => (
          <div class="flex items-start gap-4">
            <span class="text-3xl font-extrabold font-display text-corporate-purple bg-purple-50 px-3 py-1 rounded-xl border border-purple-200">
              {st.step}
            </span>
            <div>
              <h3 class="text-base font-bold text-corporate-purple-dark font-display mb-1">{st.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{st.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Form & Contact Details Section -->
  <section class="py-20 bg-corporate-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Direct Info -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="bg-corporate-purple-dark text-white rounded-3xl p-8 shadow-purple-card space-y-6">
            <h2 class="text-2xl font-bold font-display text-white border-b border-purple-900 pb-4">
              Canales Directos de Comunicación
            </h2>

            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="p-3 rounded-xl bg-purple-900/80 text-purple-300 border border-purple-800">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs text-purple-300 block uppercase font-semibold">Atención Telefónica Directa</span>
                  <a href="tel:+525512345678" class="text-lg font-bold text-white hover:text-purple-300 transition-colors">+52 (55) 1234-5678</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="p-3 rounded-xl bg-purple-900/80 text-purple-300 border border-purple-800">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <rect width="20" height="16" x="2" y="4" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs text-purple-300 block uppercase font-semibold">Correo Corporativo C-Level</span>
                  <a href="mailto:contacto@softelligent-business.com.mx" class="text-sm font-bold text-white hover:text-purple-300 transition-colors">contacto@softelligent-business.com.mx</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="p-3 rounded-xl bg-purple-900/80 text-purple-300 border border-purple-800">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs text-purple-300 block uppercase font-semibold">Oficinas Centrales</span>
                  <span class="text-sm text-purple-100">Ciudad de México, México (Servicios Nacionales e Internacionales)</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-purple-900 space-y-3">
              <div class="flex items-center gap-2 text-xs text-purple-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
                <span>Respuesta en menos de 24 horas hábiles</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-purple-300/80">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span>Horario de Atención: Lunes a Viernes 8:00 - 19:00 CST</span>
              </div>
            </div>

          </div>

          <div class="bg-white p-6 rounded-2xl border border-purple-100 shadow-sm space-y-3">
            <h3 class="text-base font-bold text-corporate-purple-dark font-display">Garantía de Confidencialidad NDA</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Toda la información compartida durante el proceso de diagnóstico está protegida legalmente. Firmamos convenios NDA antes de revisar repositorios o arquitecturas.
            </p>
          </div>

        </div>

        <!-- Right: Contact Form -->
        <div class="lg:col-span-7">
          <ContactForm
            title="Formulario de Solicitud de Diagnóstico"
            subtitle="Complete sus datos corporativos para programar la sesión privada."
            defaultService="Diagnostico Global"
          />
        </div>

      </div>
    </div>
  </section>

</Layout>
